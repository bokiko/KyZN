#!/usr/bin/env bash
# kyzn — Autonomous Code Improvement CLI
# https://github.com/bokiko/kyzn
set -euo pipefail
umask 077

# Require bash 4.3+ for associative arrays and namerefs
if (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 3) )); then
    echo "KyZN requires bash 4.3 or later (you have $BASH_VERSION)." >&2
    if [[ "$(uname)" == "Darwin" ]]; then
        echo "  Install with: brew install bash" >&2
        echo "  Then run: /opt/homebrew/bin/bash $(readlink -f "$0" 2>/dev/null || echo "$0") $*" >&2
    fi
    exit 1
fi

KYZN_VERSION="2.0.0"
# Resolve symlinks portably (readlink -f doesn't exist on macOS)
_kyzn_resolve() {
    local f="$1"
    local max_depth=20
    local depth=0
    while [[ -L "$f" ]]; do
        if (( depth++ >= max_depth )); then echo "KyZN: symlink loop detected resolving $1" >&2; echo "$f"; return 1; fi
        local dir
        dir="$(cd "$(dirname "$f")" && pwd)"
        f="$(readlink "$f")"
        [[ "$f" != /* ]] && f="$dir/$f"
    done
    echo "$f"
}
KYZN_ROOT="$(cd "$(dirname "$(_kyzn_resolve "${BASH_SOURCE[0]}")")" && pwd)"

# Load core library
# shellcheck source=lib/core.sh
source "$KYZN_ROOT/lib/core.sh"

# ---------------------------------------------------------------------------
# Subcommand routing
# ---------------------------------------------------------------------------
usage() {
    cat <<'EOF'
KyZN — Autonomous Code Improvement CLI (kaizen)

Usage:
  kyzn <command> [options]

Commands:
  fix             Deep analysis + auto-fix (analyze → fix → verify → PR)
  analyze         Deep analysis only — report, no changes
  quick           Quick single-pass improvement (lighter, cheaper)
  measure         Static measurements by default (no project commands)
  doctor          Check prerequisites
  init            Interactive setup (creates .kyzn/config.yaml)
  status          Show health score dashboard

  approve <id>    Sign off on a completed improvement
  reject <id>     Reject with reason
  diff <id>       Show what a run changed
  history         Show all runs with scores and trends
  dashboard       Machine-wide activity summary (all projects)

  schedule        Remove legacy recurring runs (creation disabled in Phase 0)
  selftest        Run the test suite
  update          Pull latest version
  version         Show version

Quick options:
  --auto              Use saved config without prompts (manual PR review still required)
  --focus <area>      Target specific area (security, testing, perf, quality, doc)
  --mode <mode>       deep | clean | full
  --model <model>     sonnet | opus | haiku
  --budget <USD>      Budget per run (e.g. 5.00)
  --turns <N>         Max Claude turns per run
  --allow-ci          Allow CI/pipeline file creation
  --allow-dirty       Allow running with uncommitted local changes
  --allow-unsafe-host-execution
                      Explicitly allow repository commands and AI changes on this host
  -v, --verbose       Show live Claude progress

Fix options:
  --auto              Run without prompts
  --fix-budget <USD>  Budget for fix phase (default: $5)
  --min-severity <s>  Minimum severity to fix (CRITICAL|HIGH|MEDIUM|LOW)
  --profile <p>       opus | hybrid | sonnet
  --budget <USD>      Budget for analysis phase
  --allow-dirty       Allow running with uncommitted local changes
  --allow-unsafe-host-execution
                      Explicitly allow repository commands and AI changes on this host

Analyze options:
  --auto              Run without prompts
  --fix               Auto-fix findings after analysis (same as 'kyzn fix')
  --fix-budget <USD>  Budget for fix phase
  --single            Use single reviewer instead of 4 specialists
  --focus <area>      Narrow analysis to one area
  --profile <p>       opus | hybrid | sonnet
  --allow-dirty       Only applies with --fix
  --allow-unsafe-host-execution
                      Enable dynamic measurements; required with --fix

Measure options:
  --allow-unsafe-host-execution
                      Enable package/build-tool measurements on this host

Doctor options:
  --install           Install project verification dependencies (Node/Python)
  --allow-unsafe-host-execution
                      Required with --install

History options:
  --global            Show history from all projects

General:
  -h, --help          Show this help
  -v, --version       Show version

Examples:
  kyzn init                       # First-time setup
  kyzn doctor                     # Check prerequisites
  kyzn fix --allow-unsafe-host-execution
                                    # Deep analysis + auto-fix → PR
  kyzn fix --auto --allow-unsafe-host-execution
                                    # Non-interactive; still requires manual PR review
  kyzn fix --profile hybrid --allow-unsafe-host-execution
                                    # Cheaper analysis model mix
  kyzn analyze                    # Analysis report only, no changes
  kyzn analyze --focus security   # Single-area deep dive
  kyzn quick --allow-unsafe-host-execution
                                    # Quick single-pass improvement
  kyzn quick --auto --allow-unsafe-host-execution
                                    # Use saved config; still requires manual PR review
  kyzn quick --mode deep --allow-unsafe-host-execution
                                    # Real improvements only
  kyzn measure                    # Static measurements (no project commands)
  kyzn measure --allow-unsafe-host-execution
                                    # Include package/build-tool measurements
  kyzn history --global           # All projects

Website:  https://www.kyzn.dev
EOF
}

# ---------------------------------------------------------------------------
# Update check — notify user if a newer version exists
# ---------------------------------------------------------------------------
check_for_updates() {
    # A linked worktree uses a .git file rather than a directory.
    [[ -e "$KYZN_ROOT/.git" ]] || return 0

    # Quick check: is local HEAD behind remote? (fetch once per day)
    local check_file="${HOME}/.kyzn/last-update-check"
    local needs_fetch=true
    mkdir -p "${HOME}/.kyzn"

    if [[ -f "$check_file" ]]; then
        local last_check now
        last_check=$(cat "$check_file" 2>/dev/null || echo 0)
        now=$(date +%s)
        if (( now - last_check < 86400 )); then needs_fetch=false; fi
    fi

    if $needs_fetch; then
        if command -v timeout &>/dev/null; then
            timeout 5 git -c core.hooksPath=/dev/null -c filter.lfs.process= -c filter.lfs.smudge= -c filter.lfs.clean= -C "$KYZN_ROOT" fetch origin --quiet 2>/dev/null || true
        else
            git -c core.hooksPath=/dev/null -c filter.lfs.process= -c filter.lfs.smudge= -c filter.lfs.clean= -C "$KYZN_ROOT" fetch origin --quiet 2>/dev/null || true
        fi
        date +%s > "$check_file" 2>/dev/null || true
    fi

    # Compare local vs remote. An update ref that cannot be resolved — a shallow
    # clone, a detached merge-ref checkout, a fork without origin/main — is not
    # an error; there is simply nothing to compare against. A bare `return` here
    # would hand Git's exit status (128) back to the caller, and because this
    # runs before command dispatch under `set -e`, that aborted the CLI before
    # it ever reached the requested command.
    local local_head remote_head
    local_head=$(git -c core.hooksPath=/dev/null -c filter.lfs.process= -c filter.lfs.smudge= -c filter.lfs.clean= -C "$KYZN_ROOT" rev-parse HEAD 2>/dev/null) || return 0
    remote_head=$(git -c core.hooksPath=/dev/null -c filter.lfs.process= -c filter.lfs.smudge= -c filter.lfs.clean= -C "$KYZN_ROOT" rev-parse origin/main 2>/dev/null) || return 0

    if [[ "$local_head" != "$remote_head" ]]; then
        local behind
        behind=$(git -c core.hooksPath=/dev/null -c filter.lfs.process= -c filter.lfs.smudge= -c filter.lfs.clean= -C "$KYZN_ROOT" rev-list --count HEAD..origin/main 2>/dev/null) || behind="?"
        # Only warn if actually behind — local-only commits (ahead) are not an update
        if [[ "$behind" != "0" ]]; then
            echo ""
            echo -e "${YELLOW}⚠ KyZN update available${RESET} (${behind} commits behind)"
            echo -e "  ${YELLOW}Update for better analysis accuracy and security fixes.${RESET}"
            echo -e "  Run: ${CYAN}kyzn update${RESET}"
            echo ""
        fi
    fi

    # The update check is advisory. It must never decide the CLI's exit status.
    return 0
}

main() {
    local cmd="${1:-}"

    # Check for updates (non-blocking, once per day) — skip for fast/local commands
    case "$cmd" in
        version|--version|-v|help|--help|-h|""|doctor|selftest) ;;
        quick|improve|fix|analyze|measure|status|init|approve|reject|diff|history|dashboard|schedule|update) check_for_updates ;;
    esac

    case "$cmd" in
        quick|improve)
            shift
            source "$KYZN_ROOT/lib/detect.sh"
            source "$KYZN_ROOT/lib/interview.sh"
            source "$KYZN_ROOT/lib/measure.sh"
            source "$KYZN_ROOT/lib/prompt.sh"
            source "$KYZN_ROOT/lib/execute.sh"
            source "$KYZN_ROOT/lib/verify.sh"
            source "$KYZN_ROOT/lib/allowlist.sh"
            source "$KYZN_ROOT/lib/report.sh"
            cmd_improve "$@"
            ;;
        fix)
            shift
            source "$KYZN_ROOT/lib/detect.sh"
            source "$KYZN_ROOT/lib/measure.sh"
            source "$KYZN_ROOT/lib/prompt.sh"
            source "$KYZN_ROOT/lib/execute.sh"
            source "$KYZN_ROOT/lib/verify.sh"
            source "$KYZN_ROOT/lib/allowlist.sh"
            source "$KYZN_ROOT/lib/report.sh"
            source "$KYZN_ROOT/lib/analyze.sh"
            cmd_analyze --fix "$@"
            ;;
        analyze)
            shift
            source "$KYZN_ROOT/lib/detect.sh"
            source "$KYZN_ROOT/lib/measure.sh"
            source "$KYZN_ROOT/lib/prompt.sh"
            source "$KYZN_ROOT/lib/execute.sh"
            source "$KYZN_ROOT/lib/verify.sh"
            source "$KYZN_ROOT/lib/allowlist.sh"
            source "$KYZN_ROOT/lib/report.sh"
            source "$KYZN_ROOT/lib/analyze.sh"
            cmd_analyze "$@"
            ;;
        measure)
            shift
            source "$KYZN_ROOT/lib/detect.sh"
            source "$KYZN_ROOT/lib/measure.sh"
            cmd_measure "$@"
            ;;
        status)
            shift
            source "$KYZN_ROOT/lib/detect.sh"
            source "$KYZN_ROOT/lib/measure.sh"
            source "$KYZN_ROOT/lib/history.sh"
            cmd_status "$@"
            ;;
        init)
            shift
            source "$KYZN_ROOT/lib/detect.sh"
            source "$KYZN_ROOT/lib/interview.sh"
            cmd_init "$@"
            ;;
        doctor)
            shift
            cmd_doctor "$@"
            ;;
        approve)
            shift
            source "$KYZN_ROOT/lib/approve.sh"
            source "$KYZN_ROOT/lib/history.sh"
            cmd_approve "$@"
            ;;
        reject)
            shift
            source "$KYZN_ROOT/lib/approve.sh"
            source "$KYZN_ROOT/lib/history.sh"
            cmd_reject "$@"
            ;;
        diff)
            shift
            source "$KYZN_ROOT/lib/history.sh"
            cmd_diff "$@"
            ;;
        history)
            shift
            source "$KYZN_ROOT/lib/history.sh"
            cmd_history "$@"
            ;;
        dashboard)
            shift
            source "$KYZN_ROOT/lib/history.sh"
            cmd_dashboard "$@"
            ;;
        schedule)
            shift
            source "$KYZN_ROOT/lib/schedule.sh"
            cmd_schedule "$@"
            ;;
        update)
            shift
            log_step "Updating KyZN..."
            if safe_git -C "$KYZN_ROOT" pull --quiet 2>/dev/null; then
                local new_ver
                new_ver=$(bash "$KYZN_ROOT/kyzn" version 2>/dev/null || echo "unknown")
                log_ok "Updated to $new_ver"
            else
                log_error "Update failed — check git status in $KYZN_ROOT"
                exit 1
            fi
            ;;
        selftest)
            shift
            bash "$KYZN_ROOT/tests/selftest.sh" "$@"
            ;;
        version|--version|-v)
            echo "KyZN v${KYZN_VERSION}"
            ;;
        help|--help|-h|"")
            usage
            ;;
        *)
            log_error "Unknown command: $cmd"
            echo ""
            usage
            exit 1
            ;;
    esac
}

# ---------------------------------------------------------------------------
# Doctor — prerequisite checker
# ---------------------------------------------------------------------------
cmd_doctor() {
    local install_deps=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --install) install_deps=true; shift ;;
            --allow-unsafe-host-execution) _KYZN_UNSAFE_HOST_EXECUTION_ALLOWED=true; shift ;;
            *) log_error "Unknown option: $1"; return 1 ;;
        esac
    done

    if $install_deps; then
        require_unsafe_host_execution "doctor dependency installation" || return 1
    fi

    log_header "KyZN doctor — checking prerequisites"
    local ok=true

    # Required tools
    local -a required=("git" "gh" "claude" "jq" "yq")
    for tool in "${required[@]}"; do
        if command -v "$tool" &>/dev/null; then
            local ver
            case "$tool" in
                git)    ver=$(git --version | awk '{print $3}') ;;
                gh)     ver=$(gh --version | head -1 | awk '{print $3}') ;;
                claude) ver=$(claude --version 2>/dev/null || echo "unknown") ;;
                jq)     ver=$(jq --version 2>/dev/null || echo "unknown") ;;
                yq)     ver=$(yq --version 2>/dev/null | awk '{print $NF}') ;;
            esac
            log_ok "$tool ($ver)"
        else
            log_fail "$tool — not found"
            case "$tool" in
                git)
                    log_dim "  Install: sudo apt install git  (or brew install git)" ;;
                gh)
                    log_dim "  Install: https://cli.github.com" ;;
                claude)
                    log_dim "  Install: npm install -g @anthropic-ai/claude-code" ;;
                jq)
                    log_dim "  Install: sudo apt install jq  (or brew install jq)" ;;
                yq)
                    log_dim "  Install: https://github.com/mikefarah/yq#install" ;;
            esac
            ok=false
        fi
    done

    # Non-agent status probe: never start a model session from an untrusted
    # repository merely to check credentials.
    if claude auth status --json &>/dev/null 2>&1; then
        log_ok "Claude auth: configured"
    else
        log_warn "Claude not authenticated. Either:"
        log_dim "  • Run 'claude' and log in via browser (recommended)"
        log_dim "  • Or set ANTHROPIC_API_KEY environment variable"
    fi

    # GitHub auth
    if gh auth status &>/dev/null; then
        log_ok "gh authenticated"
    else
        log_warn "gh not authenticated (run: gh auth login)"
    fi

    # Optional tools by language
    echo ""
    log_info "Optional tools (per project type):"

    local _opt_tool _opt_desc
    for _opt_tool in npm npx eslint tsc ruff mypy pytest cargo go govulncheck dotnet mvn gradle; do
        case "$_opt_tool" in
            npm|npx)     _opt_desc="Node.js" ;;
            eslint)      _opt_desc="Node.js linting" ;;
            tsc)         _opt_desc="TypeScript" ;;
            ruff)        _opt_desc="Python linting" ;;
            mypy)        _opt_desc="Python types" ;;
            pytest)      _opt_desc="Python testing" ;;
            cargo)       _opt_desc="Rust" ;;
            go)          _opt_desc="Go" ;;
            govulncheck) _opt_desc="Go security" ;;
            dotnet)      _opt_desc=".NET / C#" ;;
            mvn)         _opt_desc="Java / JVM (Maven)" ;;
            gradle)      _opt_desc="Java / JVM (Gradle)" ;;
        esac
        if command -v "$_opt_tool" &>/dev/null; then
            log_ok "$_opt_tool ($_opt_desc)"
        else
            log_dim "$_opt_tool ($_opt_desc) — not installed"
        fi
    done

    if $install_deps; then
        echo ""
        log_info "Installing project verification dependencies (--install)"
        if git rev-parse --is-inside-work-tree &>/dev/null; then
            # shellcheck source=lib/detect.sh
            source "$KYZN_ROOT/lib/detect.sh"
            # shellcheck source=lib/verify.sh
            source "$KYZN_ROOT/lib/verify.sh"
            detect_project_type
            install_project_dependencies
        else
            log_error "--install requires running inside a git repository"
            ok=false
        fi
    fi

    echo ""
    if $ok; then
        log_ok "All required tools found. KyZN is ready."
        echo ""
        echo -e "  ${DIM}Next:${RESET} Run ${CYAN}kyzn init${RESET} to set up a project, or ${CYAN}kyzn measure${RESET} to check health."
        echo -e "  ${DIM}Docs:${RESET} ${CYAN}https://www.kyzn.dev${RESET}"
    else
        log_fail "Missing required tools. Install them and re-run kyzn doctor."
        echo -e "  ${DIM}Tip: The installer auto-installs jq and yq:${RESET}"
        echo -e "  ${CYAN}bash install.sh${RESET}  (from the KyZN repo directory)"
        exit 1
    fi
}

main "$@"
